  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c75237bba6dd854e838583a8ea48218, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Albert
        icon: {fileID: -890019732, guid: 4c56b98edf429e449b01757e74b92795, type: 3}
      line: "Please don\u2019t kill me\u2026"
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: "I\u2019m here to set you free. What did they do to you?"
    - character:
        name: Albert
        icon: {fileID: -890019732, guid: 4c56b98edf429e449b01757e74b92795, type: 3}
      line: "They caught me because I gave books to\nstudents. They say it\u2019s
        subversion, but I just\nwant the truth to be known."
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: "Just act natural. I'll open door and just stay near\n me. "
  disableAfterDialogue: 0
