        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: 'Excuse me po. Tito Fred, do you know where the

        Santos Building
        is at Brgy. Maligaya?'
    - character:
        name: Fred
        icon: {fileID: -1409969219, guid: 253ec701c685c1a49a44bcfba4ab353f, type: 3}
      line: "That address\u2026 sounds familiar, but I don't know\nwhere it is exactly,
        eh."
