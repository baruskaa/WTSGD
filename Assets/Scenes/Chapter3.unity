  dialogue:
    dialogueLines:
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: "Wait\u2026 this looks familiar.\r\n"
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: "Ugh, it\u2019s too late to think clearly. I\u2019ll continue \nthis
        tomorrow. \r\n"
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: 'I should write these down first, and I''ll ask

        someone to help
        me understand them better

        tomorrow.'
