  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Daniel
        icon: {fileID: -190318419, guid: ed3192d0b7168ad498b4f451357543ca, type: 3}
      line: "Please don\u2019t kill me\u2026"
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: "I\u2019m here to set you free. What did they do to you?"
    - character:
        name: Daniel
        icon: {fileID: -190318419, guid: ed3192d0b7168ad498b4f451357543ca, type: 3}
      line: "I was just passing by. They said I looked\nsuspicious and arrested me
        all of the sudden.\nPlease\u2026 help me."
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: "Just act natural. I'll open door and just stay near\n me. "
