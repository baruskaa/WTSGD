--- !u!114 &2044319029
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2044319026}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c75237bba6dd854e838583a8ea48218, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Luz
        icon: {fileID: -1204348759, guid: 28c170289bf877c4084196a40a78310c, type: 3}
      line: 'Did you hear? Trixie''s been taken by the

        soldiers last night.'
    - character:
        name: Celia
        icon: {fileID: -477458262, guid: 6202833a656ff5142845bf480947ac1f, type: 3}
      line: "Really? I\u2019m not even surprised anymore. She\u2019s \na journalist,
        right?"
    - character:
        name: Luz
        icon: {fileID: -1204348759, guid: 28c170289bf877c4084196a40a78310c, type: 3}
      line: "Yeah. And they\u2019ve been going after journalists \na lot lately."
    - character:
        name: Celia
        icon: {fileID: -477458262, guid: 6202833a656ff5142845bf480947ac1f, type: 3}
      line: "Doesn\u2019t she have a younger brother?"
    - character:
        name: Luz
        icon: {fileID: -1204348759, guid: 28c170289bf877c4084196a40a78310c, type: 3}
      line: She does. Si Tim. That poor kid.
