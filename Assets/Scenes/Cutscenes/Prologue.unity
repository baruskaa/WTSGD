--- !u!114 &1390856393
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2483104491463179670}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c75237bba6dd854e838583a8ea48218, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: 'Excuse me po. Kuya, do you know where

        the Santos Building is
        at Brgy. Maligaya?'
    - character:
        name: Vendor
        icon: {fileID: -1409969219, guid: 253ec701c685c1a49a44bcfba4ab353f, type: 3}
      line: "Uh, I think\u2014"
    - character:
        name: Soldier
        icon: {fileID: -634761428, guid: eac1a7be2fd06fa428ba62f8af8fb978, type: 3}
      line: "That\u2019s an unusual place to ask about, \nkid\u2026 What are you
        up to?"
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: I... Um...
    - character:
        name: Soldier
        icon: {fileID: -634761428, guid: eac1a7be2fd06fa428ba62f8af8fb978, type: 3}
      line: You're one of them, are you?
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: "No! I-I'm\u2014"
    - character:
        name: Vendor
        icon: {fileID: -95128087, guid: a3a416c09c18cd9438e7a0a66153df6d, type: 3}
      line: S-sir, I think you're scaring the kid...
    - character:
        name: Soldier
        icon: {fileID: -634761428, guid: eac1a7be2fd06fa428ba62f8af8fb978, type: 3}
      line: "I'm just gonna ask him a ques\u2014"
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: Let go of me!
    - character:
        name: Soldier
        icon: {fileID: -634761428, guid: eac1a7be2fd06fa428ba62f8af8fb978, type: 3}
      line: You've done it now, kid.
  disableAfterDialogue: 1
  isDialogueOnInteract: 1
  isDisableAlert: 0
  Alert: {fileID: 0}
  startQuestAfterDialogue: 1
  questNumberToStart: 6
