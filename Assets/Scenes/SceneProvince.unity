MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 180271758}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c75237bba6dd854e838583a8ea48218, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: 'Thanks for the lunch, Ninang. I''ll head out

        for a bit.'
    - character:
        name: Jemma
        icon: {fileID: -1204348759, guid: 28c170289bf877c4084196a40a78310c, type: 3}
      line: "I know you're gonna look for clues outside,\n Tim."
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: "I\u2014"
    - character:
        name: Jemma
        icon: {fileID: -1204348759, guid: 28c170289bf877c4084196a40a78310c, type: 3}
      line: 'And I know that there''s nothing I can do to

        stop you.'
    - character:
        name: Jemma
        icon: {fileID: -1204348759, guid: 28c170289bf877c4084196a40a78310c, type: 3}
      line: 'I''m as worried about your ate as you are. So

        please... Take
        care of yourself...'
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: Thank you, Ninang. I will.
    - character:
        name: Jemma
        icon: {fileID: -1204348759, guid: 28c170289bf877c4084196a40a78310c, type: 3}
      line: Stay safe, hijo. Mag-ingat ka.
  disableAfterDialogue: 1
  isDialogueOnInteract: 0
  objectToReset: {fileID: 0}
  isDisableAlert: 0
  Alert: {fileID: 0}
  startQuestAfterDialogue: 0
  questNumberToStart: 0
