--- !u!114 &1704129727
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1704129725}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c75237bba6dd854e838583a8ea48218, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: "Excuse me po. Tita Luz, do you\u2014"
    - character:
        name: Luz
        icon: {fileID: -1204348759, guid: 28c170289bf877c4084196a40a78310c, type: 3}
      line: 'Tim! I heard about what happened to your

        sister. Are you alright?'
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: 'I''m alright naman po. Do you know where the

        Santos Building
        is at Brgy. Maligaya?'
    - character:
        name: Celia
        icon: {fileID: -477458262, guid: 6202833a656ff5142845bf480947ac1f, type: 3}
      line: "That place? I remember hearing on the radio.\nThe government\u2019s
        been keeping a close eye\non that building. "
    - character:
        name: Luz
        icon: {fileID: -1204348759, guid: 28c170289bf877c4084196a40a78310c, type: 3}
      line: 'Nako, Tim. Best not to go there. You might

        get yourself in
        trouble.'
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: Oh... Sige po, thank you po...
    - character:
        name: Timothy
        icon: {fileID: 21300000, guid: 93ff86fa36ceb3444b2c45a4307005e5, type: 2}
      line: '*If what they said was real, then why does

        Ate want me to go
        to that place?*'
  disableAfterDialogue: 1
  isDialogueOnInteract: 1
  objectToReset: {fileID: 0}
  isDisableAlert: 0
  Alert: {fileID: 0}
  startQuestAfterDialogue: 0
  questNumberToStart: 0
